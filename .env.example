# Copy to .env and edit. NEVER commit .env or paste keys in chats.

# Shared secret between your Node API and this service.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY=put-a-long-random-string-here

# "auto" = try the providers in PROVIDER_ORDER one by one (next one is used if a provider
# is rate-limited, out of credit, or down). Or set one name: gemini, groq, cerebras, mistral,
# openrouter, openai, local. Any request can still override with {"provider": "groq"}.
DEFAULT_PROVIDER=auto

# Order matters. Put "local" FIRST if you want data-privacy priority (schema names then never
# leave your machine unless the local model fails). Providers with an empty key are skipped.
PROVIDER_ORDER=groq,openrouter,local

# ---------- FREE online providers (leave key empty to disable) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional. Only for models that support it (gpt-oss: low/medium/high). Leave commented for Qwen.
# GROQ_REASONING_EFFORT=low

# https://openrouter.ai/keys  (use model names that end in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------- Paid (optional) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Local (Ollama). Needs no key; used only if "local" is in PROVIDER_ORDER ----------
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5-coder:3b
LOCAL_API_KEY=ollama

# ---------- Behaviour ----------
MAX_ROWS=1000
MAX_TABLES_IN_PROMPT=4
MAX_REPAIR_ATTEMPTS=2
REQUEST_TIMEOUT=45
ENFORCE_TABLE_WHITELIST=true
SCHEMA_FILE=schema/schema.json
EXAMPLES_FILE=schema/examples.json
