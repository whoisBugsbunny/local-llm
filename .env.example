# .env

# Shared secret: your Node API sends this in the X-API-Key header.
# For Creating New: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY=put-a-long-random-string-here

# Which provider is used when the caller does not choose one: "openai" or "local"
DEFAULT_PROVIDER=auto

# Order matters. Put "local" FIRST if you want data-privacy priority (schema names then never
# leave your machine unless the local model fails). Providers with an empty key are skipped.
PROVIDER_ORDER=groq,gemini,openrouter,local

# ---------- FREE online providers (leave key empty to disable) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b

# https://openrouter.ai/keys  (use model names that end in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Online (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local (Ollama / llama.cpp / vLLM / LM Studio: anything OpenAI-compatible) ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5-coder:3b
LOCAL_API_KEY=ollama

# --- Behaviour ---
MAX_ROWS=1000
MAX_TABLES_IN_PROMPT=12
MAX_REPAIR_ATTEMPTS=2
REQUEST_TIMEOUT=60
ENFORCE_TABLE_WHITELIST=true
SCHEMA_FILE=schema/schema.json
EXAMPLES_FILE=schema/examples.json
